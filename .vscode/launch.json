{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Luna (Flask)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONUTF8": "1"
      },
      "justMyCode": true,
      "serverReadyAction": {
        "pattern": "\\* Running on (http://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "IA Escolar (terminal)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ia_escolar.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONUTF8": "1"
      },
      "justMyCode": true
    }
  ]
}
